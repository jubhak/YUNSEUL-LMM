+            print(f"  [참고] drift {b.get('drift_cents')} → {a.get('drift_cents')} cent, "
+                  f"jitter {b.get('jitter_cents')} → {a.get('jitter_cents')} cent "
+                  f"(합성 신호 기준, 판정 보류)")
+            check("전/후 지표가 실제로 측정됨",
